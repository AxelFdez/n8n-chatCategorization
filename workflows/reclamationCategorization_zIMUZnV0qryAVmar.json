    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"subject\": \"Retards répétés et manque d'information\",\n  \"from\": {\n    \"name\": \"Pierre Martin\",\n    \"address\": \"pierre.martin@outlook.com\"\n  },\n  \"body\": \"Bonjour,\\n\\nJe prends la ligne 3 tous les jours pour me rendre au travail et depuis 3 semaines, j'ai au moins 2 retards de plus de 20 minutes par semaine.\\n\\nCe matin encore, le métro est resté bloqué 25 minutes entre Saxe-Gambetta et Part-Dieu sans aucune annonce claire sur la durée de l'attente.\\n\\nCes dysfonctionnements récurrents impactent ma vie professionnelle. Je suis arrivé en retard à 4 réunions importantes ce mois-ci.\\n\\nPouvez-vous m'expliquer ce qui se passe et quand la situation va s'améliorer ?\\n\\nCordialement,\\nPierre Martin\",\n  \"date\": \"2025-11-22T08:45:00.000Z\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.set",
